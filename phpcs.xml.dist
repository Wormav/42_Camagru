<?xml version="1.0"?>
<ruleset name="Camagru">
	<description>Camagru coding standard — PSR-12.</description>

	<file>src</file>
	<file>public</file>
	<file>config</file>

	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>src/View/templates/*</exclude-pattern>

	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg value="p"/>

	<rule ref="PSR12"/>
</ruleset>
