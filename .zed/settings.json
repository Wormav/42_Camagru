{
	"languages": {
		"PHP": {
			"language_servers": ["intelephense", "phpcs", "!phpactor", "!phptools"],
			"format_on_save": "on",
			"formatter": {
				"external": {
					"command": "bash",
					"arguments": [
						"-c",
						"temp=$(mktemp) && cat > $temp && ./vendor/bin/php-cs-fixer fix --quiet --using-cache=no $temp 2>/dev/null && cat $temp && rm $temp"
					]
				}
			},
			"code_actions_on_format": {
				"source.fixAll.phpcs": true
			}
		}
	}
}
